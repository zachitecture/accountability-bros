// Tells Cloudflare how to publish the site: build with "npm run build",
// then serve the files in dist/ as a plain static website.
{
  "name": "accountability-bros",
  "compatibility_date": "2026-06-01",
  // Switch on the free accountability-bros.<account>.workers.dev address.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
